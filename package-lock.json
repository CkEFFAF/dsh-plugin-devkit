{
  "name": "dsh-plugin-devkit",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "dsh-plugin-devkit",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/dsh-debug-boot": {
      "resolved": "packages/dsh-debug-boot",
      "link": true
    },
    "node_modules/dsh-debugger": {
      "resolved": "packages/dsh-debugger",
      "link": true
    },
    "node_modules/dsh-plugin-preview": {
      "resolved": "packages/dsh-plugin-preview",
      "link": true
    },
    "node_modules/dsh-plugin-test": {
      "resolved": "packages/dsh-plugin-test",
      "link": true
    },
    "packages/dsh-debug-boot": {
      "version": "0.1.0",
      "bin": {
        "debug-boot": "bin/debug-boot.mjs"
      }
    },
    "packages/dsh-debugger": {
      "version": "0.1.0"
    },
    "packages/dsh-plugin-preview": {
      "version": "0.1.0",
      "bin": {
        "dsh-plugin-preview": "bin/preview.mjs"
      }
    },
    "packages/dsh-plugin-test": {
      "version": "0.1.0",
      "dependencies": {
        "dsh-debugger": "*"
      },
      "bin": {
        "dsh-plugin-test": "bin/plugin-test.mjs"
      }
    }
  }
}
